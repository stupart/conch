<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>conch</string>
	<key>CFBundleDisplayName</key>
	<string>conch</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- conch's whole premise is a phone in your pocket. Without this, iOS
	     suspends the app the moment the screen locks: AVSpeechSynthesizer makes
	     no sound, and the app cannot even send its "stopped speaking" report,
	     which is the dropped report that latched the Mac's dashboard at
	     "speaking". Tyler, on his phone: "it's saying it's speaking and not
	     speaking and also not hearing it speak". -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>conch sends a picture you choose to your own Mac, so an agent there can look at it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>conch listens while you talk to your coding sessions. Audio never leaves this phone.</string>
	<key>NSCameraUsageDescription</key>
	<string>conch scans the encrypted relay pairing QR shown by your Mac.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>conch turns your voice into text on this phone, then sends only the text to your Mac.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>conch connects to the conch daemon running on your Mac over your own Wi-Fi.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
